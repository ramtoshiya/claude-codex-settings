{
  "description": "humanize: warn about AI buzzwords before a file write, commit, PR, or Slack/Linear post, without blocking it. Changed in the ramtoshiya fork to run through uv-managed Python.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch|Slack__slack_(send|schedule|create_canvas|update_canvas)|Linear__save_|mcp__.*(?:slack_(?:send|schedule|create_canvas|update_canvas)|linear.*save_)",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --offline --no-project --managed-python --python '>=3.11' --no-config --exclude-newer '3 days' python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/humanize.py\""
          }
        ]
      },
      {
        "matcher": "Bash|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --offline --no-project --managed-python --python '>=3.11' --no-config --exclude-newer '3 days' python \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/humanize.py\""
          }
        ]
      }
    ]
  }
}
